# GitHub PAT: repo read for GraphQL/search + contents:write on LinklyAI/best-skills
GITHUB_TOKEN=

# X search via RapidAPI (twitter-api45; free tier = 1000 req/month, one daily run ≈ 110)
RAPIDAPI_KEY=

# Bluesky search auth. Optional but strongly recommended: anonymous search is rate
# limited per source IP and that quota is shared with everything else leaving the
# same address, so a hosted runner can be refused before it sends a request.
# Handle plus an app password from Settings > Privacy and Security > App Passwords.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# jev (TypeSafe's decision model) via OpenRouter — judges post relevance for HN / Bluesky / X
# and skill quality + category. Base must serve OpenRouter's
# /systemone endpoint: https://openrouter.ai/api/v1
LLM_API_BASE=
LLM_API_KEY=
# Optional; defaults to the pinned typesafe/jev-1.13 (thresholds are tuned against it)
LLM_MODEL=

# Path to the local clone of the public data repo (default ../best-skills)
BEST_SKILLS_REPO_PATH=
