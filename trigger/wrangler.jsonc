{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "best-skills-trigger",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	// Cron-only Worker: no HTTP surface, so no workers.dev hostname either.
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"GITHUB_REPO": "LinklyAI/best-skills",
		"WORKFLOW_FILE": "daily.yml",
		"WORKFLOW_REF": "main"
	},
	// 00:30 UTC — after the UTC day rolls over (data is archived by UTC date),
	// with half an hour of margin for the registries' own midnight roll-ups and
	// for the runner-pool rush at the top of the hour. daily.yml's own
	// `schedule:` (01:17) arrives 4-5 h late; this one fires on the minute.
	"triggers": {
		"crons": ["30 0 * * *"]
	},
	"observability": {
		"enabled": true
	}
}
